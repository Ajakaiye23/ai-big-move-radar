# Copy to .env.local and fill in from your Supabase project settings (API section).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: where OAuth should send people back to. Defaults to the request origin,
# which is what you want locally and on most hosts.
# NEXT_PUBLIC_SITE_URL=https://chips.example.com
